rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthorizedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'klebersanchez1982@gmail.com'
      );
    }

    function currentRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(role) {
      return isSignedIn() && currentRole() == role;
    }

    function isTeamMember() {
      return hasRole('garcom') || hasRole('assador') || hasRole('caixa');
    }

    function validRoleValue(value) {
      return value == null || value in ['garcom', 'assador', 'caixa'];
    }

    function validProductWrite() {
      return request.resource.data.keys().hasOnly([
        'name',
        'price',
        'category',
        'available',
        'stock'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 120
      && request.resource.data.price is number
      && request.resource.data.price >= 0
      && request.resource.data.category is string
      && request.resource.data.category.size() > 0
      && request.resource.data.available is bool
      && request.resource.data.stock is int
      && request.resource.data.stock >= 0;
    }

    function validOrderItem(item) {
      return item.keys().hasOnly(['id', 'productId', 'productName', 'quantity', 'price', 'status'])
      && item.id is string
      && item.productId is string
      && item.productName is string
      && item.quantity is int
      && item.quantity > 0
      && item.price is number
      && item.price >= 0
      && item.status in ['pendente', 'preparo', 'pronto'];
    }

    function validClient(client) {
      return client.keys().hasOnly(['name', 'phone'])
      && client.name is string
      && client.phone is string;
    }

    function validOrderWrite() {
      return request.resource.data.keys().hasOnly([
        'table',
        'client',
        'items',
        'status',
        'createdAt',
        'closedAt',
        'paymentMethod',
        'totalPaid'
      ])
      && request.resource.data.table is string
      && request.resource.data.table.size() > 0
      && validClient(request.resource.data.client)
      && request.resource.data.items is list
      && request.resource.data.items.size() >= 0
      && request.resource.data.items.size() <= 200
      && request.resource.data.items.all(item, validOrderItem(item))
      && request.resource.data.status in ['aberta', 'andamento', 'fechada']
      && request.resource.data.createdAt is timestamp
      && (!('closedAt' in request.resource.data) || request.resource.data.closedAt is timestamp)
      && (!('paymentMethod' in request.resource.data) || request.resource.data.paymentMethod in ['dinheiro', 'pix', 'cartao'])
      && (!('totalPaid' in request.resource.data) || (request.resource.data.totalPaid is number && request.resource.data.totalPaid >= 0));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || hasRole('caixa'));

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['role', 'roles', 'updatedAt', 'email'])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && (
          // sincronizacao inicial de email sem perfil definido
          (!('role' in request.resource.data) && !('roles' in request.resource.data))
          || (
            request.resource.data.role in ['garcom', 'assador', 'caixa']
            && request.resource.data.roles is list
            && request.resource.data.roles.size() > 0
            && request.resource.data.roles.size() <= 3
            && request.resource.data.roles.all(r, r in ['garcom', 'assador', 'caixa'])
            && request.resource.data.roles.hasAny([request.resource.data.role])
            && (
              request.resource.data.role in ['garcom', 'assador']
              || (request.resource.data.role == 'caixa' && isAuthorizedAdmin())
            )
          )
        )
        && request.resource.data.updatedAt is timestamp;

      // User can define role if it is null (first assignment),
      // then cannot change it anymore. Caixa can manage any role.
      // Only authorized admins can self-assign 'caixa' role.
      allow update: if (
          isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['role', 'roles', 'updatedAt', 'email'])
          && (!('email' in request.resource.data)
            || (
              request.resource.data.email is string
              && request.resource.data.email == request.auth.token.email
            ))
          && (
            // self apenas troca modulo atual dentre modulos ja liberados
            (
              request.resource.data.role in ['garcom', 'assador', 'caixa']
              && request.resource.data.roles is list
              && request.resource.data.roles.size() > 0
              && request.resource.data.roles.size() <= 3
              && request.resource.data.roles.all(r, r in ['garcom', 'assador', 'caixa'])
              && request.resource.data.roles.hasAny([request.resource.data.role])
              && (
                (
                  !('roles' in resource.data)
                  && resource.data.role in ['garcom', 'assador', 'caixa']
                  && request.resource.data.roles.hasAny([resource.data.role])
                )
                || request.resource.data.roles == resource.data.roles
                || isAuthorizedAdmin()
              )
            )
            // ou somente sincroniza email mantendo role/roles atuais
            || (
              (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
              && (
                !('roles' in resource.data)
                || (!('roles' in request.resource.data) || request.resource.data.roles == resource.data.roles)
              )
            )
          )
          && (
            (
              resource.data.role == null
              && (
                request.resource.data.role in ['garcom', 'assador']
                || (request.resource.data.role == 'caixa' && isAuthorizedAdmin())
              )
            )
            ||
            (
              request.resource.data.role == resource.data.role
              || request.resource.data.roles.hasAny([request.resource.data.role])
              || (isAuthorizedAdmin() && request.resource.data.role in ['garcom', 'assador', 'caixa'])
            )
          )
          && request.resource.data.updatedAt is timestamp
        )
        || (
          hasRole('caixa')
          && request.resource.data.keys().hasOnly(['role', 'roles', 'updatedAt', 'email'])
          && request.resource.data.role in ['garcom', 'assador', 'caixa']
          && request.resource.data.roles is list
          && request.resource.data.roles.size() > 0
          && request.resource.data.roles.size() <= 3
          && request.resource.data.roles.all(r, r in ['garcom', 'assador', 'caixa'])
          && request.resource.data.roles.hasAny([request.resource.data.role])
          && (!('email' in request.resource.data)
            || (
              request.resource.data.email is string
              && (!('email' in resource.data) || request.resource.data.email == resource.data.email)
            ))
          && request.resource.data.updatedAt is timestamp
        );

      allow delete: if false;
    }

    // products
    match /products/{productId} {
      allow read: if isTeamMember();

      // Only caixa can create/update products and stock.
      allow create, update, delete: if hasRole('caixa') && validProductWrite();
    }

    // orders
    match /orders/{orderId} {
      // Team can read orders in real-time.
      allow read: if isTeamMember();

      // Garcom creates/updates order content, assador updates item status,
      // caixa can close orders and apply payment fields.
      allow create: if hasRole('garcom') && validOrderWrite();
      allow update: if isTeamMember() && validOrderWrite();

      // Optional hard-delete by caixa only.
      allow delete: if hasRole('caixa');
    }
  }
}
