rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthorizedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'klebersanchez1982@gmail.com'
        || request.auth.token.email == 'klebervsanchez@gmail.com'
        || request.auth.token.email == 'master2@nabrasa.local'
        || request.auth.token.email == 'master@nabrasa.local'
      );
    }

    function currentRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(role) {
      return isSignedIn() && currentRole() == role;
    }

    function canManageUsers() {
      return hasRole('caixa') || isAuthorizedAdmin();
    }

    function isTeamMember() {
      return hasRole('garcom') || hasRole('assador') || hasRole('caixa');
    }

    function validProductWrite() {
      return request.resource.data.keys().hasOnly([
        'name',
        'price',
        'category',
        'available',
        'stock'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 120
      && request.resource.data.price is number
      && request.resource.data.price >= 0
      && request.resource.data.category is string
      && request.resource.data.category.size() > 0
      && request.resource.data.available is bool
      && request.resource.data.stock is int
      && request.resource.data.stock >= 0;
    }

    function validOrderItem(item) {
      return item.keys().hasOnly(['id', 'productId', 'productName', 'quantity', 'price', 'status'])
      && item.id is string
      && item.productId is string
      && item.productName is string
      && item.quantity is int
      && item.quantity > 0
      && item.price is number
      && item.price >= 0
      && item.status in ['pendente', 'preparo', 'pronto'];
    }

    function validClient(client) {
      return client.keys().hasOnly(['name', 'phone'])
      && client.name is string
      && client.phone is string;
    }

    function validOrderWrite() {
      return request.resource.data.keys().hasOnly([
        'table',
        'client',
        'items',
        'status',
        'createdAt',
        'closedAt',
        'paymentMethod',
        'totalPaid'
      ])
      && request.resource.data.table is string
      && request.resource.data.table.size() > 0
      && validClient(request.resource.data.client)
      && request.resource.data.items is list
      && request.resource.data.items.size() >= 0
      && request.resource.data.items.size() <= 200
      && request.resource.data.items.all(item, validOrderItem(item))
      && request.resource.data.status in ['aberta', 'andamento', 'fechada']
      && request.resource.data.createdAt is timestamp
      && (!('closedAt' in request.resource.data) || request.resource.data.closedAt is timestamp)
      && (!('paymentMethod' in request.resource.data) || request.resource.data.paymentMethod in ['dinheiro', 'pix', 'cartao'])
      && (!('totalPaid' in request.resource.data) || (request.resource.data.totalPaid is number && request.resource.data.totalPaid >= 0));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || canManageUsers());

      function validRoleAndRoles() {
        return request.resource.data.role in ['garcom', 'assador', 'caixa']
          && request.resource.data.roles is list
          && request.resource.data.roles.size() > 0
          && request.resource.data.roles.size() <= 3
          && request.resource.data.roles.all(r, r in ['garcom', 'assador', 'caixa'])
          && request.resource.data.roles.hasAny([request.resource.data.role]);
      }

      function validDisabledField() {
        return !('disabled' in request.resource.data)
          || request.resource.data.disabled is bool;
      }

      function validUsernameField() {
        return !('username' in request.resource.data)
          || (
            request.resource.data.username is string
            && request.resource.data.username.matches('^[a-z0-9._-]{3,40}$')
          );
      }

      function validEmailForSelf() {
        return !('email' in request.resource.data)
          || (
            request.resource.data.email is string
            && request.resource.data.email == request.auth.token.email
          );
      }

      function validSelfIdentityCreateOnly() {
        return request.resource.data.keys().hasOnly(['email', 'username', 'updatedAt'])
          && validEmailForSelf()
          && validUsernameField()
          && request.resource.data.updatedAt is timestamp;
      }

      function validSelfIdentityUpdateOnly() {
        return request.resource.data.keys().hasOnly(['role', 'roles', 'updatedAt', 'email', 'username', 'disabled'])
          && validEmailForSelf()
          && validUsernameField()
          && validDisabledField()
          && request.resource.data.updatedAt is timestamp
          && (
            (!('role' in resource.data) && !('role' in request.resource.data))
            || request.resource.data.role == resource.data.role
          )
          && (
            (!('roles' in resource.data) && !('roles' in request.resource.data))
            || (
              'roles' in resource.data
              && 'roles' in request.resource.data
              && request.resource.data.roles == resource.data.roles
            )
          )
          && (
            (!('disabled' in resource.data) && !('disabled' in request.resource.data))
            || (
              'disabled' in resource.data
              && 'disabled' in request.resource.data
              && request.resource.data.disabled == resource.data.disabled
            )
          );
      }

      function validAuthorizedAdminSelfBootstrap() {
        return isAuthorizedAdmin()
          && request.resource.data.keys().hasOnly(['role', 'roles', 'updatedAt', 'email', 'username', 'disabled'])
          && validRoleAndRoles()
          && request.resource.data.role == 'caixa'
          && request.resource.data.roles.hasAny(['caixa'])
          && validEmailForSelf()
          && validUsernameField()
          && validDisabledField()
          && request.resource.data.updatedAt is timestamp;
      }

      function validEmailForAdminCreate() {
        return !('email' in request.resource.data)
          || request.resource.data.email is string;
      }

      function validEmailForAdminWrite() {
        return !('email' in request.resource.data)
          || (
            request.resource.data.email is string
            && (!('email' in resource.data) || request.resource.data.email == resource.data.email)
          );
      }

      function validAdminIdentityOrBlockOnly() {
        return request.resource.data.keys().hasOnly(['role', 'roles', 'updatedAt', 'email', 'username', 'disabled'])
          && validUsernameField()
          && validDisabledField()
          && validEmailForAdminWrite()
          && request.resource.data.updatedAt is timestamp
          && (
            (!('role' in resource.data) && !('role' in request.resource.data))
            || request.resource.data.role == resource.data.role
          )
          && (
            (!('roles' in resource.data) && !('roles' in request.resource.data))
            || (
              'roles' in resource.data
              && 'roles' in request.resource.data
              && request.resource.data.roles == resource.data.roles
            )
          );
      }

      function isProtectedMasterUser() {
        return (('username' in resource.data) && resource.data.username == 'master2')
          || (('email' in resource.data) && resource.data.email == 'master2@nabrasa.local');
      }

      allow create: if (
          isSignedIn()
          && request.auth.uid == userId
          && (validSelfIdentityCreateOnly() || validAuthorizedAdminSelfBootstrap())
        )
        || (
          canManageUsers()
          && request.resource.data.keys().hasOnly(['role', 'roles', 'updatedAt', 'email', 'username', 'disabled'])
          && validRoleAndRoles()
          && validUsernameField()
          && validDisabledField()
          && validEmailForAdminCreate()
          && request.resource.data.updatedAt is timestamp
        );

      allow update: if (
          isSignedIn()
          && request.auth.uid == userId
          && (validSelfIdentityUpdateOnly() || validAuthorizedAdminSelfBootstrap())
        )
        || (
          canManageUsers()
          && (
            (
              request.resource.data.keys().hasOnly(['role', 'roles', 'updatedAt', 'email', 'username', 'disabled'])
              && validRoleAndRoles()
              && validUsernameField()
              && validDisabledField()
              && validEmailForAdminWrite()
              && request.resource.data.updatedAt is timestamp
            )
            || validAdminIdentityOrBlockOnly()
          )
        );

      allow delete: if canManageUsers() && !isProtectedMasterUser();
    }

    // products
    match /products/{productId} {
      allow read: if isTeamMember();

      // Only caixa can create/update products and stock.
      allow create, update, delete: if hasRole('caixa') && validProductWrite();
    }

    // orders
    match /orders/{orderId} {
      // Team can read orders in real-time.
      allow read: if isTeamMember();

      // Garcom creates/updates order content, assador updates item status,
      // caixa can close orders and apply payment fields.
      allow create: if hasRole('garcom') && validOrderWrite();
      allow update: if isTeamMember() && validOrderWrite();

      // Optional hard-delete by caixa only.
      allow delete: if hasRole('caixa');
    }
  }
}
